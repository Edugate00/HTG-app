<mvc:View
	controllerName="lrlpapp.controller.Utility"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:ndc="sap.ndc"
	xmlns="sap.m"
>
	<VBox class="header-container">
		<Button
			text="Back"
			icon="sap-icon://nav-back"
			press="onNavBack"
		/>
	</VBox>
	<HBox
		class="wrapper"
		height="600px"
	>
		<VBox
			class="card"
			width="100%"
			height="80%"
		>
			<HBox class="card-header">
				<Text
					class="card-title"
					text="Current measurement"
				/>
			</HBox>
			<VBox class="sapUiMediumMarginBeginEnd">
				<VBox class="sapUiSmallMarginTopBottom">
					<Title text="Measurement Point"/>
					<Input
						id="CurrentMeasPoint"
						type="Number"
						placeholder="Input Measurement Point"
					/>
				</VBox>
				<!-- <VBox class="sapUiSmallMarginTopBottom">
					<Title text="Measurement Description"/>
					<Text
						id="CurrentMeasDescription"
						text="-"
					/>
				</VBox> -->
				<VBox class="sapUiSmallMarginTopBottom">
					<Title text="Measurement Date and time"/>
					<Text
						id="CurrentMeasDateTime"
						text="-"
					/>
				</VBox>
				<VBox class="sapUiSmallMarginTopBottom">
					<Title text="Measurement Reader"/>
					<Text
						id="CurrentMeasReader"
						text="abap1"
					/>
				</VBox>
				<VBox class="sapUiSmallMarginTopBottom">
					<Title text="Measurement Value"/>
					<Input
						id="CurrentMeasValue"
						type="Number"
						placeholder="Input Measurement Value"
					/>
				</VBox>
				<HBox>
					<Button
						text="Post Measurement"
						type="Emphasized"
						press="OnPostMeasurement"
					/>
					<!-- <Button
						class="sapUiSmallMarginBeginEnd"
						text="Scan QR"
						press="OnScanQR"
					/> -->
					<ndc:BarcodeScannerButton
						id="barcodeScannerDialog"
						class="sapUiSmallMarginBeginEnd"
						scanSuccess="onScanSuccess"
						scanFail="onScanError"
					/>
				</HBox>
			</VBox>
		</VBox>
		<VBox
			class="card"
			width="100%"
			height="80%"
		>
			<HBox class="card-header">
				<Text
					class="card-title"
					text="Previous measurements"
				/>
			</HBox>
			<VBox class="sapUiMediumMarginBeginEnd">
				<VBox class="sapUiSmallMarginTopBottom">
					<Title text="Measurement Document"/>
					<Text
						id="PrevMeasDocument"
						text="-"
					/>
				</VBox>
				<VBox class="sapUiSmallMarginTopBottom">
					<Title text="Measurement Point"/>
					<Text
						id="PrevMeasPoint"
						text="-"
					/>
				</VBox>
				<!-- <VBox class="sapUiSmallMarginTopBottom">
					<Title text="Measurement Description"/>
					<Text
						id="PrevMeasDescription"
						text="-"
					/>
				</VBox> -->
				<VBox class="sapUiSmallMarginTopBottom">
					<Title text="Measurement Date and time"/>
					<Text
						id="PrevMeasDateTime"
						text="-"
					/>
				</VBox>
				<VBox class="sapUiSmallMarginTopBottom">
					<Title text="Measurement Value"/>
					<Text
						id="PrevMeasValue"
						text="-"
					/>
				</VBox>
				<VBox class="sapUiSmallMarginTopBottom">
					<Title text="Measurement Reader"/>
					<Text
						id="PrevMeasReader"
						text="-"
					/>
				</VBox>
			</VBox>
		</VBox>
	</HBox>
</mvc:View>