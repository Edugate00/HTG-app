<mvc:View
    controllerName="htgapp.controller.Utility"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Page showHeader="false">
        <VBox class="header-container" />
        <VBox class="main-container">
            <HBox class="tiles">
                <VBox
                    class="tile"
                    id="tilePemakaianListrik">
                    <FlexBox class="tile-header">
                        <VBox class="tile-icon sapUiSmallMarginEnd">
                            <core:Icon
                                src="sap-icon://measurement-document"
                                class="size1"
                                color="#ffffff" />
                        </VBox>
                        <Text
                            class="tile-title"
                            text="Pemakaian Listrik" />
                    </FlexBox>
                    <VBox class="tile-info">
                        <!-- <Text
							class="dynamic-number"
							text="3" />
						<Text text="Tagihan untuk dicetak" /> -->
                    </VBox>
                </VBox>
                <VBox
                    class="tile"
                    id="tilePindaiMeteran">
                    <FlexBox class="tile-header">
                        <VBox class="tile-icon sapUiSmallMarginEnd">
                            <core:Icon
                                src="sap-icon://qr-code"
                                class="size1"
                                color="#ffffff" />
                        </VBox>
                        <Text
                            class="tile-title"
                            text="Pindai Meteran" />
                    </FlexBox>
                    <VBox class="tile-info">    
                        <FlexBox alignItems="Center" items="{notif>/notif}">
                            <Text
                                class="dynamic-number"
                                text="{notif>pindaiMeteran}" />
                        </FlexBox>
                        <HBox items="{notif>/notif}">
                            <Text text="{notif>pindaiMeteranDesc}" />
                        </HBox>
                    </VBox>
                </VBox>
                
            </HBox>
            <VBox class="card-tagihan card" height="600px">
                <FlexBox
                    class="card-header">
                    <Text class="card-title" text="Tagihan" />
                    <Button icon="sap-icon://filter" press="openFilterDialog" />
                </FlexBox>
                <ScrollContainer
                    height="90%"
                    vertical="true">
                    <List
                        id="tagihanList"
                        items="{utilities>/utilityList}">
                        <items>
                            <ObjectListItem
                                type="Active"
                                number="{utilities>NetValue}"
                                numberUnit="IDR"
                                press="onSelectListTagihan"
                                title="{utilities>BillingNumber} - {utilities>CustomerDesc}">
                                <ObjectAttribute
                                    title="Tipe"
                                    text="{utilities>MaterialDesc}" />
                                <ObjectAttribute
                                    title="Tanggal"
                                    text="{utilities>BillingDate}" />
                                <secondStatus>
                                    <ObjectStatus
                                        text="{utilities>Status}"
                                        state="{utilities>TipeStatus}" />
                                </secondStatus>
                            </ObjectListItem>
                        </items>
                    </List>
                </ScrollContainer>
            </VBox>
        </VBox>
    </Page>
</mvc:View>