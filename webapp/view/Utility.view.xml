<mvc:View
	controllerName="lrlpapp.controller.Utility"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns="sap.m"
>
	<Page showHeader="false">
		<VBox class="header-container">

		</VBox>
		<VBox class="main-container">
			<HBox class="tiles">
				<VBox
					class="tile"
					id="tilePemakaianListrik" >
					<FlexBox class="tile-header">
						<VBox class="tile-icon sapUiSmallMarginEnd">
							<core:Icon
								src="sap-icon://measurement-document"
								class="size1"
								color="#ffffff" />
						</VBox>
						<Text
							class="tile-title"
							text="Pemakaian Listrik" />
					</FlexBox>
					<VBox class="tile-info">
						<!-- <Text
							class="dynamic-number"
							text="3" />
						<Text text="Tagihan untuk dicetak" /> -->
					</VBox>
				</VBox>
				<VBox
					class="tile"
					id="tilePindaiMeteran" >
					<FlexBox class="tile-header">
						<VBox class="tile-icon sapUiSmallMarginEnd">
							<core:Icon
								src="sap-icon://qr-code"
								class="size1"
								color="#ffffff" />
						</VBox> 
						<Text
							class="tile-title"
							text="Pindai Meteran" />
					</FlexBox>
					<VBox class="tile-info">
						<!-- <Text
							class="dynamic-number"
							text="3" />
						<Text text="Tagihan untuk dicetak" /> -->
					</VBox>
				</VBox>
				<VBox
					class="tile"
					id="tileAirBulanan" >
					<FlexBox class="tile-header">
						<VBox class="tile-icon sapUiSmallMarginEnd">
							<core:Icon
								src="sap-icon://activity-2"
								class="size1"
								color="#ffffff" />
						</VBox>
						<Text
							class="tile-title"
							text="Pemakaian Air" />
					</FlexBox>
					<VBox class="tile-info">
						<!-- <Text
							class="dynamic-number"
							text="3" />
						<Text text="Tagihan untuk dicetak" /> -->
					</VBox>
				</VBox>
				<VBox
					class="tile"
					id="tileTagihanAir">
					<FlexBox class="tile-header">
						<VBox class="tile-icon sapUiSmallMarginEnd">
							<core:Icon
								src="sap-icon://my-sales-order"
								class="size1"
								color="#ffffff" />
						</VBox>
						<Text
							class="tile-title"
							text="Perhitungan Tagihan Air" />
					</FlexBox>
					<VBox class="tile-info">
						<!-- <Text
							class="dynamic-number"
							text="3" />
						<Text text="Tagihan untuk dicetak" /> -->
					</VBox>
				</VBox>
			</HBox>	
			<VBox class="card-tagihan card">
				<FlexBox
					class="card-header">
					<Text
						class="card-title"
						text="Tagihan" />
					<HBox>
						<ComboBox
							id="ComboBoxTagihanTenant"
							width="132px"
							placeholder="Pilih Tenant"
							selectionChange="onTagihanTenantSelected"
							selectedKey="*"
							class="sapUiTinyMarginEnd sapMCbAutoFocus">
							<core:Item
								key="*"
								text="Semua Tenant" />
							<core:Item
								key="Karimata"
								text="Karimata" />
							<core:Item
								key="Butterfield"
								text="Butterfield" />
							<core:Item
								key="Woori"
								text="Woori" />
							<core:Item
								key="Sharinc"
								text="Sharinc" />
						</ComboBox>
						<ComboBox
							id="ComboBoxTagihanStatus"
							width="132px"
							placeholder="Select Status"
							selectionChange="onStatusSelect"
							selectedKey="*"
							class="sapMCbAutoFocus">
							<core:Item
								key="*"
								text="Semua" />
							<core:Item
								key="paid"
								text="Sudah dibayar" />
							<core:Item
								key="unpaid"
								text="Belum dibayar" />
						</ComboBox>
					</HBox>
				</FlexBox>
				<ScrollContainer
					height="90%"
					vertical="true">
					<List
						id="tagihanList"
						items="{tagihan>/tagihan}">
						<items>
							<ObjectListItem
								type="Active"
								title="{tagihan>noTagihan} - {tagihan>tenant}">
								<ObjectAttribute
									title="Tipe"
									text="{tagihan>tipe}" />
								<ObjectAttribute
									title="Tanggal"
									text="{tagihan>dueDate}" />
								<secondStatus>
									<ObjectStatus
										text="{tagihan>status}"
										state="{tagihan>tipeStatus}" />
								</secondStatus>
							</ObjectListItem>
						</items>
					</List>
				</ScrollContainer>
			</VBox>
		</VBox>
	</Page>
</mvc:View>