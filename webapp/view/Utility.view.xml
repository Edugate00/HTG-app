<mvc:View
	controllerName="lrlpapp.controller.Utility"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:ndc="sap.ndc"
	xmlns="sap.m"
>
	<Page showHeader="false">
		<VBox class="header-container">
			
				<!-- <Button
					text="Back"
					icon="sap-icon://nav-back"
					press="onNavBack"
				/> -->
			
		</VBox>
		<FlexBox
			class="main-container sapUiLargeMarginBottom"
			height="600px"
			justifyContent="Center"
		>
			<VBox
				class="card"
				width="30%"
			>
				<HBox class="card-header">
					<Text
						class="card-title"
						text="Current measurement"
					/>
				</HBox>
				<VBox class="sapUiMediumMarginBeginEnd">
					<VBox class="sapUiSmallMarginTopBottom">
						<Title text="Measurement Date and time"/>
						<Text
							id="CurrentMeasDateTime"
							text="-"
						/>
					</VBox>
					<VBox class="sapUiSmallMarginTopBottom">
						<Title text="Measurement Point"/>
						<FlexBox direction="Row">
							<Input
								id="CurrentMeasPoint"
								type="Number"
								placeholder="Input Measurement Point"
							/>
							<ndc:BarcodeScannerButton
								id="barcodeScannerDialog"
								class="sapUiSmallMarginBeginEnd"
								scanSuccess="onScanSuccess"
								scanFail="onScanError"
							/>
						</FlexBox>
					</VBox>
					<VBox class="sapUiSmallMarginTopBottom">
						<Title text="Deskripsi"/>
						<Text text="LRLP-CITIWALK-CONTAINER_1A"/>
					</VBox>
					<VBox class="sapUiSmallMarginTopBottom">
						<Title text=" Prev Value"/>
						<HBox>
							<Text text="12.701 L"/>
							<Text
								class="sapUiSmallMarginBegin"
								text="13-02-2023 / 15:00:00"
							/>
						</HBox>
					</VBox>
					<VBox class="sapUiSmallMarginTopBottom">
						<FlexBox direction="Row">
							<VBox>
								<Title text="Measurement Value"/>
								<Input
									id="CurrentMeasValue"
									type="Number"
									enabled="false"
									placeholder="Input Measurement Value"
								/>
							</VBox>
							<VBox class="sapUiSmallMarginBegin"/>
						</FlexBox>
					</VBox>
					<VBox class="sapUiSmallMarginTopBottom">
						<VBox>
							<Title text="Total Pemakaian (Air/Listrik)"/>
							<Text text="13.800 L"/>
						</VBox>
					</VBox>
					<HBox>
						<Button
							text="Post Measurement"
							type="Emphasized"
							press="OnPostMeasurement"
						/>
					</HBox>
				</VBox>
			</VBox>
		</FlexBox>
	</Page>
</mvc:View>