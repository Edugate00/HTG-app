<mvc:View
    controllerName="lrlpapp.controller.Rental"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns="sap.m"
    xmlns:custom="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">
    <SplitApp
        id="rentalBills"
        initialDetail="detailEmpty"
        initialMaster="master">
        <masterPages>
            <Page
                id="master"
                showHeader="true"
                backgroundDesign="List"
                title="Kontrak Sewa"
                class="sapUiResponsivePadding--header">
                <List
                    id="tagihanRentalList"
                    itemPress=".onTagihanRentalSelect"
                    items="{rentalMaster>/rentalMaster}">
                    <items>
                        <ObjectListItem
                            type="Active"
                            custom:to="detail"
                            title="{rentalMaster>NamaTenant}">
                            <ObjectAttribute
                                title="Kontainer"
                                text="{rentalMaster>KontainerDesc}" />
                            <ObjectAttribute
                                title="No. Kontrak"
                                text="{rentalMaster>NomorKontrak}" />
                            <ObjectAttribute
                                title="Masa Kontrak"
                                text="{rentalMaster>KontrakStart} - {rentalMaster>KontrakEnd}" />
                        </ObjectListItem>
                    </items>
                </List>
            </Page>
        </masterPages>
        <detailPages>
            <Page
                id="detail"
                backgroundDesign="List"
                showNavButton="{device>/system/phone}"
                navButtonPress="onNavBackToMaster"
                title="Detail Kontrak Sewa"
                class="sapUiResponsivePadding--header">
                <ObjectHeader
                    title="{rentalDetail>/NamaTenant}"
                    backgroundDesign="Solid"
                    responsive="{device>/system/phone}"
                    fullScreenOptimized="true">
                    <attributes>
                        <ObjectAttribute text="{rentalDetail>/NomorKontrak}" title="No. Kontrak" />
                        <ObjectAttribute text="{rentalDetail>/KontainerDesc}" title="Kontainer" />
                        <ObjectAttribute title="Masa Kontrak"
                            text="{rentalDetail>/KontrakStart} - {rentalDetail>/KontrakEnd}" />
                        <ObjectAttribute title="Nilai Sewa per bulan"
                            text="{rentalDetail>/NilaiSewaPerBln}" />
                        <ObjectAttribute title="Biaya Pengelolaan per bulan"
                            text="{rentalDetail>/BiayaPemeliharaanPerBln}" />
                        <ObjectAttribute title="Ditagih setiap"
                            text="{rentalDetail>/TagihanSetiapDesc}" />
                        <ObjectAttribute text="{rentalDetail>/TipePajakDesc}" />
                    </attributes>
                    <statuses>
                        <ObjectStatus
                            text="Informasi Kontak:"
                            state="None" />
                        <ObjectStatus
                            text="{rentalDetail>/PicTenant}"
                            state="Information" />
                        <ObjectStatus
                            text="{rentalDetail>/NomorKontak}"
                            state="Information" />
                        <ObjectStatus
                            text="{rentalDetail>/Alamat}"
                            state="Information" />
                        <ObjectStatus
                            text="{rentalDetail>/District}, {rentalDetail>/City}"
                            state="Information" />
                        <ObjectStatus
                            text="{rentalDetail>/Telepone}"
                            state="Information" />
                    </statuses>
                </ObjectHeader>
                <VBox>
                    <IconTabBar>
                        <items>
                            <IconTabFilter
                                key="sewa"
                                text="Skema Sewa">
                                <l:VerticalLayout
                                    class="sapUiContentPadding sapUiLargeMarginBottom"
                                    width="100%">
                                    <VBox class="cardContainer">
                                        <List
                                            id="listTagihanSewa"
                                            class="sapUiMediumMarginBottom"
                                            busyIndicatorDelay="500"
                                            enableBusyIndicator="true"
                                            noDataText="Tidak ada tagihan"
                                            items="{listTagihanSewa>/listTagihanSewa}">
                                            <items>
                                                <ObjectListItem
                                                    title="{listTagihanSewa>BillingNumber}"
                                                    press=".onSelectListTagihan"
                                                    type="Active">
                                                    <ObjectAttribute
                                                        title="Periode Tagihan"
                                                        text="{listTagihanSewa>Periode}" />
                                                    <ObjectAttribute
                                                        title="Nilai Tagihan"
                                                        text="{listTagihanSewa>NetValue}" />
                                                    <secondStatus>
                                                        <ObjectStatus
                                                            text="{listTagihanSewa>StatusTagihan}"
                                                            state="{listTagihanSewa>StatusType}" />
                                                    </secondStatus>
                                                </ObjectListItem>
                                            </items>
                                        </List>
                                    </VBox>
                                </l:VerticalLayout>
                            </IconTabFilter>
                            <IconTabFilter
                                key="pengelolaan"
                                text="Skema Pengelolaan">
                                <l:VerticalLayout
                                    class="sapUiContentPadding sapUiLargeMarginBottom"
                                    width="100%">
                                    <VBox class="cardContainer">
                                        <List
                                            id="listTagihanPengelolaan"
                                            class="sapUiMediumMarginBottom"
                                            busyIndicatorDelay="500"
                                            enableBusyIndicator="true"
                                            noDataText="Tidak ada tagihan"
                                            items="{listTagihanPengelolaan>/listTagihanPengelolaan}">
                                            <items>
                                                <ObjectListItem
                                                    title="{listTagihanPengelolaan>BillingNumber}"
                                                    press=".onSelectListTagihan"
                                                    type="Active">
                                                    <ObjectAttribute
                                                        title="Periode Tagihan"
                                                        text="{listTagihanPengelolaan>Periode}" />
                                                    <ObjectAttribute
                                                        title="Nilai Tagihan"
                                                        text="{listTagihanPengelolaan>NetValue}" />
                                                    <secondStatus>
                                                        <ObjectStatus
                                                            text="{listTagihanPengelolaan>StatusTagihan}"
                                                            state="{listTagihanPengelolaan>StatusType}" />
                                                    </secondStatus>
                                                </ObjectListItem>
                                            </items>
                                        </List>
                                    </VBox>
                                </l:VerticalLayout>
                            </IconTabFilter>
                            <IconTabFilter
                                key="air"
                                text="Tagihan Air">
                                <l:VerticalLayout
                                    class="sapUiContentPadding sapUiLargeMarginBottom"
                                    width="100%">
                                    <VBox class="cardContainer">
                                        <List
                                            id="listTagihanAir"
                                            class="sapUiMediumMarginBottom"
                                            busyIndicatorDelay="500"
                                            enableBusyIndicator="true"
                                            noDataText="Tidak ada tagihan"
                                            items="{listTagihanAir>/listTagihanAir}">
                                            <items>
                                                <ObjectListItem
                                                    title="{listTagihanAir>BillingNumber}"
                                                    press=".onSelectListTagihan"
                                                    type="Active">
                                                    <ObjectAttribute
                                                        title="Periode Tagihan"
                                                        text="{listTagihanAir>Periode}" />
                                                    <ObjectAttribute
                                                        title="Nilai Tagihan"
                                                        text="{listTagihanAir>NetValue}" />
                                                    <secondStatus>
                                                        <ObjectStatus
                                                            text="{listTagihanAir>PaymentStatus}"
                                                            state="{listTagihanAir>StatusType}" />
                                                    </secondStatus>
                                                </ObjectListItem>
                                            </items>
                                        </List>
                                    </VBox>
                                </l:VerticalLayout>
                            </IconTabFilter>
                        </items>
                    </IconTabBar>
                </VBox>
            </Page>
            <Page
                id="detailEmpty"
                backgroundDesign="List"
                title="Detail Kontrak Sewa"
                class="sapUiResponsivePadding--header">
                <FlexBox
                    justifyContent="Center"
                    alignItems="Center"
                    width="100%"
                    height="100%">
                    <IllustratedMessage
                        class="sapUiLargeMarginTop"
                        description="Detail kontrak sewa akan muncul disini"
                        title="Silahkan pilih kontrak sewa"
                        illustrationType="sapIllus-PageNotFound"
                        visible="true" />
                </FlexBox>
            </Page>
        </detailPages>
    </SplitApp>
</mvc:View>