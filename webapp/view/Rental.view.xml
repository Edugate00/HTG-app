<mvc:View
    controllerName="lrlpapp.controller.Rental"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns="sap.m"
    xmlns:custom="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">
    <SplitApp
        id="rentalBills"
        initialDetail="detailEmpty"
        initialMaster="master">
        <masterPages>
            <Page
                id="master"
                showHeader="true"
                backgroundDesign="List"
                title="Tenant"
                class="sapUiResponsivePadding--header">
                <List
                    id="tagihanRentalList"
                    itemPress=".onTagihanRentalSelect">
                    <items>
                        <ObjectListItem
                            type="Active"
                            custom:to="detail"
                            title="Karimata">
                            <ObjectAttribute
                                text="Container X" />
                            <ObjectAttribute
                                title="Nomor Kontrak"
                                text="40000070" />
                            <ObjectAttribute
                                title="Masa Kontrak"
                                text="03 Mar, 2023 - 03 Mar, 2025" />
                        </ObjectListItem>
                    </items>
                </List>
            </Page>
        </masterPages>
        <detailPages>
            <Page
                id="detail"
                backgroundDesign="List"
                showNavButton="{device>/system/phone}"
                navButtonPress="onNavBackToMaster"
                title="Detail Tagihan"
                class="sapUiResponsivePadding--header">
                <ObjectHeader
                    title="Karimata"
                    backgroundDesign="Solid"
                    responsive="false"
                    fullScreenOptimized="true">
                    <attributes>
                        <ObjectAttribute text="Container X" />
                        <ObjectAttribute title="Masa Kontrak" text="03 Mar, 2023 - 03 Mar, 2025" />
                        <ObjectAttribute title="Nilai Sewa per bulan" text="Rp 30.000.000,-" />
                        <ObjectAttribute title="Biaya Pemeliharaan per bulan" text="Rp 1.250.000,-" />
                        <ObjectAttribute title="Ditagih setiap" text="4 bulan" />
                        <ObjectAttribute text="Tidak Potong PPh 4 / 2" />
                    </attributes>
                    <statuses>
                        <ObjectStatus
                            text="Informasi Kontak:"
                            state="None" />
                        <ObjectStatus
                            text="Rima"
                            state="Information" />
                        <ObjectStatus
                            text="0822 8888 0808"
                            state="Information" />
                        <ObjectStatus
                            text="Jl. Lebak bulus 06"
                            state="Information" />
                    </statuses>
                </ObjectHeader>
                <VBox>
                    <IconTabBar>
                        <items>
                            <IconTabFilter
                                key="sewa"
                                text="Tagihan Sewa">
                                <l:VerticalLayout
                                    class="sapUiContentPadding"
                                    width="100%">
                                    <VBox class="cardContainer">
                                        <List
                                            busyIndicatorDelay="500"
                                            enableBusyIndicator="true"
                                            noDataText="Tidak ada tagihan"
                                            items="">
                                            <items>
                                                <ObjectListItem
                                                    title="90064639"
                                                    press="."
                                                    type="Active">
                                                    <ObjectAttribute
                                                        title="Periode Tagihan"
                                                        text="03 Jan, 2023 - 03 Apr, 2023" />
                                                    <ObjectAttribute
                                                        title="Nilai Tagihan"
                                                        text="Rp 149.000.000,-" />
                                                    <secondStatus>
                                                        <ObjectStatus
                                                            text="Belum Dibayar"
                                                            state="Error" />
                                                    </secondStatus>
                                                </ObjectListItem>
                                            </items>
                                        </List>
                                    </VBox>
                                </l:VerticalLayout>
                            </IconTabFilter>
                            <IconTabFilter
                                key="pengelolaan"
                                text="Tagihan Pengelolaan">
                                <l:VerticalLayout
                                    class="sapUiContentPadding"
                                    width="100%">
                                    <VBox class="cardContainer">
                                        <List
                                            busyIndicatorDelay="500"
                                            enableBusyIndicator="true"
                                            noDataText="Tidak ada tagihan"
                                            items="">
                                            <items>
                                                <ObjectListItem
                                                    title="90064639"
                                                    press="."
                                                    type="Active">
                                                    <ObjectAttribute
                                                        title="Periode Tagihan"
                                                        text="03 Jan, 2023 - 03 Apr, 2023" />
                                                    <ObjectAttribute
                                                        title="Nilai Tagihan"
                                                        text="Rp 149.000.000,-" />
                                                    <secondStatus>
                                                        <ObjectStatus
                                                            text="Belum Dibayar"
                                                            state="Error" />
                                                    </secondStatus>
                                                </ObjectListItem>
                                            </items>
                                        </List>
                                    </VBox>
                                </l:VerticalLayout>
                            </IconTabFilter>
                            <IconTabFilter
                                key="air"
                                text="Tagihan Air">
                                <l:VerticalLayout
                                    class="sapUiContentPadding"
                                    width="100%">
                                    <VBox class="cardContainer">
                                        <List
                                            busyIndicatorDelay="500"
                                            enableBusyIndicator="true"
                                            noDataText="Tidak ada tagihan"
                                            items="">
                                            <items>
                                                <ObjectListItem
                                                    title="90064639"
                                                    press="."
                                                    type="Active">
                                                    <ObjectAttribute
                                                        title="Periode Tagihan"
                                                        text="03 Jan, 2023 - 03 Apr, 2023" />
                                                    <ObjectAttribute
                                                        title="Nilai Tagihan"
                                                        text="Rp 149.000.000,-" />
                                                    <secondStatus>
                                                        <ObjectStatus
                                                            text="Belum Dibayar"
                                                            state="Error" />
                                                    </secondStatus>
                                                </ObjectListItem>
                                            </items>
                                        </List>
                                    </VBox>
                                </l:VerticalLayout>
                            </IconTabFilter>
                        </items>
                    </IconTabBar>
                </VBox>
            </Page>
            <Page
                id="detailEmpty"
                backgroundDesign="List"
                title="Detail Tagihan"
                class="sapUiResponsivePadding--header">
                <FlexBox
                    justifyContent="Center"
                    alignItems="Center"
                    width="100%"
                    height="100%">
                    <IllustratedMessage
                        class="sapUiLargeMarginTop"
                        description="Detail tagihan akan muncul disini setelah dipilih"
                        title="Tidak ada tagihan yang dipilih"
                        illustrationType="sapIllus-PageNotFound"
                        visible="true" />
                </FlexBox>
            </Page>
        </detailPages>
    </SplitApp>
</mvc:View>