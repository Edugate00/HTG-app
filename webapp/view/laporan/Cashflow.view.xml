<mvc:View
    controllerName="lrlpapp.controller.laporan.Cashflow"
    xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:smartTable="sap.ui.comp.smarttable">
    <Page
        id="cashFlowPage"
        showHeader="false"
        class="sapUiResponsivePadding--header">
        <content>
            <VBox class="header-container" />
            <VBox class="main-container">
                <VBox class="card">
                    <Table
                        id="cashFlowTable"
                        backgroundDesign="Translucent"
                        noDataText="Tidak ada data"
                        headerText="Report Cashflow Citiwalk"
                        items="{cashFlowModel>/cashflow}">
                        <columns>
                            <Column>
                                <Label text="Cash inflows" />
                            </Column>
                            <Column
                                hAlign="End">
                                <Label text="" />
                            </Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{cashFlowModel>account}" />
                                    <Text text="{cashFlowModel>value}" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </VBox>
            </VBox>
        </content>
    </Page>
</mvc:View>