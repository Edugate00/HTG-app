<mvc:View
    controllerName="lrlpapp.controller.laporan.Cashflow"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page
        id="cashFlowPage"
        showHeader="false"
        class="sapUiResponsivePadding--header">
        <content>
            <VBox class="header-container" />
            <VBox class="main-container">
                <VBox class="card">
                    <FlexBox
                        class="card-header" justifyContent="SpaceBetween">
                        <Text class="card-title" text="Cashflow Report Citiwalk" />
                    </FlexBox>
                    <f:SimpleForm
                        id="formCashflowReport"
                        editable="true"
                        layout="ResponsiveGridLayout">
                        <f:content>
                            <VBox>
                                <Label text="Company:" />
                                <Input
                                    enabled="false"
                                    value="LRLP" />
                            </VBox>
                            <VBox>
                                <Label text="Periode:" />
                                <ComboBox
                                    id="perioedFromDD"
                                    width="100%"
                                    placeholder="Select Periode"
                                >
                                    <core:Item
                                        key="01"
                                        text="Januari" />
                                    <core:Item
                                        key="02"
                                        text="Februari" />
                                    <core:Item
                                        key="03"
                                        text="Maret" />
                                    <core:Item
                                        key="04"
                                        text="April" />
                                    <core:Item
                                        key="05"
                                        text="Mei" />
                                    <core:Item
                                        key="06"
                                        text="Juni" />
                                    <core:Item
                                        key="07"
                                        text="Juli" />
                                    <core:Item
                                        key="08"
                                        text="Agustus" />
                                    <core:Item
                                        key="09"
                                        text="September" />
                                    <core:Item
                                        key="10"
                                        text="Oktober" />
                                    <core:Item
                                        key="11"
                                        text="November" />
                                    <core:Item
                                        key="12"
                                        text="Desember" />
                                </ComboBox>
                            </VBox>
                            <VBox>
                                <Label text="Year:" />
                                <ComboBox
                                    id="yearDD"
                                    width="100%"
                                    placeholder="Select Year"
                                    selectedKey=""
                                    items="{selectedYear>/selectedYear}"
                                >
                                    <core:ListItem
                                        key="{selectedYear>year}"
                                        text="{selectedYear>year}" />
                                </ComboBox>
                            </VBox>
                            <VBox width="100%">
                                <Label text="" />
                                <Button
                                    width="100%"
                                    type="Emphasized"
                                    text="Apply Filter"
                                    press="getCashflowData"
                                />
                            </VBox>
                        </f:content>
                    </f:SimpleForm>
                </VBox>
                <VBox
                    id="cashflowContainer"
                    class="cashflow-container card-cashflow">
                </VBox>
            </VBox>
        </content>
    </Page>
</mvc:View>