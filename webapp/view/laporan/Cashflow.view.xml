<mvc:View
    controllerName="lrlpapp.controller.laporan.Cashflow"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page
        id="cashFlowPage"
        showHeader="false"
        class="sapUiResponsivePadding--header">
        <content>
            <VBox class="header-container" />
            <VBox class="main-container">
                <VBox class="card">
                    <FlexBox
                        class="card-header" justifyContent="SpaceBetween">
                        <Text class="card-title" text="Report Cashflow Citiwalk" />
                    </FlexBox>
                    <f:SimpleForm
                        id="formCashflowReport"
                        editable="true"
                        layout="ResponsiveGridLayout">
                        <f:content>
                            <VBox>
                                <Label text="Company:" />
                                <Input
                                    enabled="false"
                                    value="LRLP" />
                            </VBox>
                            <VBox>
                                <Label text="Periode:" />
                                <ComboBox
                                    id="perioedFromDD"
                                    width="100%"
                                    placeholder="Select Periode">
                                    <core:Item
                                        key="01"
                                        text="Januari" />
                                    <core:Item
                                        key="02"
                                        text="Februari" />
                                    <core:Item
                                        key="03"
                                        text="Maret" />
                                    <core:Item
                                        key="04"
                                        text="April" />
                                    <core:Item
                                        key="05"
                                        text="Mei" />
                                    <core:Item
                                        key="06"
                                        text="Juni" />
                                    <core:Item
                                        key="07"
                                        text="Juli" />
                                    <core:Item
                                        key="08"
                                        text="Agustus" />
                                    <core:Item
                                        key="09"
                                        text="September" />
                                    <core:Item
                                        key="10"
                                        text="Oktober" />
                                    <core:Item
                                        key="11"
                                        text="November" />
                                    <core:Item
                                        key="12"
                                        text="Desember" />
                                </ComboBox>
                            </VBox>
                            <VBox>
                                <Label text="Year:" />
                                <ComboBox
                                    id="yearDD"
                                    width="100%"
                                    placeholder="Select Year"
                                    selectedKey="">
                                    <core:Item
                                        key="2023"
                                        text="2023" />
                                </ComboBox>
                            </VBox>
                            <VBox width="100%">
                                <Label text="" />
                                <Button
                                    width="100%"
                                    type="Emphasized"
                                    text="Apply Filter"
                                    press="onApplyPress"
                                />
                            </VBox>
                        </f:content>
                    </f:SimpleForm>
                </VBox>
                <VBox id="tableContainer" class="card">
                    <Table
                        id="bankBalanceTable"
                        noDataText="Tidak ada data"
                        items="{bankBalance>/bankBalance}">
                        <columns>
                            <Column>
                                <Label text="Bank Balance" />
                            </Column>
                            <Column
                                hAlign="Center">
                                <Label text="Selected Month" />
                            </Column>

                            <!-- <Column
                                hAlign="Center">
                                <Label text="Previous Month" />
                            </Column>

                            <Column
                                hAlign="Center">
                                <Label text="Variances" />
                            </Column> -->
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{bankBalance>account}" />
                                    <Text text="{bankBalance>value}" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                    <VBox height="24px"></VBox>
                    <Table
                        headerText="Cash Inflows"
                        id="operatingActTableIn"
                        noDataText="Tidak ada data"
                        items="{inOperatingActs>/inOperatingActs}">
                        <columns>
                            <Column>
                                <Label text="Operating Activities" />
                            </Column>
                            <Column
                                hAlign="Center">
                                <Label text="" />
                            </Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{inOperatingActs>account}" />
                                    <Text text="{inOperatingActs>value}" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                    <VBox height="24px"></VBox>
                    <Table
                        id="financingActTableIn"
                        noDataText="Tidak ada data"
                        items="{inFinancingActs>/inFinancingActs}">
                        <columns>
                            <Column>
                                <Label text="Financing Activities" />
                            </Column>
                            <Column
                                hAlign="Center">
                                <Label text="" />
                            </Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{inFinancingActs>account}" />
                                    <Text text="{inFinancingActs>value}" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                    <Table
                        id="investingActTableIn"
                        noDataText="Tidak ada data"
                        items="{inInvestingActs>/inInvestingActs}">
                        <columns>
                            <Column>
                                <Label text="Investing Activities" />
                            </Column>
                            <Column
                                hAlign="Center">
                                <Label text="" />
                            </Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{inInvestingActs>account}" />
                                    <Text text="{inInvestingActs>value}" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                    <Table
                        id="otherAndTotalTableIn"
                        noDataText="Tidak ada data"
                        items="{inOtherAndTotal>/inOtherAndTotal}">
                        <columns>
                            <Column>
                                <Label text="" />
                            </Column>
                            <Column
                                hAlign="Center">
                                <Label text="" />
                            </Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{inOtherAndTotal>account}" />
                                    <Text text="{inOtherAndTotal>value}" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                    <!-- Cash Outflows mulai dari sini yak!!!! -->
                    <Table
                        headerText="Cash Outflows"
                        id="operatingActTableOut"
                        noDataText="Tidak ada data"
                        items="{outOperatingActs>/outOperatingActs}">
                        <columns>
                            <Column>
                                <Label text="Operating Activities" />
                            </Column>
                            <Column
                                hAlign="Center">
                                <Label text="" />
                            </Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{outOperatingActs>account}" />
                                    <Text text="{outOperatingActs>value}" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                    <VBox height="24px"></VBox>
                    <Table
                        id="financingActTableOut"
                        noDataText="Tidak ada data"
                        items="{outFinancingActs>/outFinancingActs}">
                        <columns>
                            <Column>
                                <Label text="Financing Activities" />
                            </Column>
                            <Column
                                hAlign="Center">
                                <Label text="" />
                            </Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{outFinancingActs>account}" />
                                    <Text text="{outFinancingActs>value}" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                    <Table
                        id="investingActTableOut"
                        noDataText="Tidak ada data"
                        items="{outInvestingActs>/outInvestingActs}">
                        <columns>
                            <Column>
                                <Label text="Investing Activities" />
                            </Column>
                            <Column
                                hAlign="Center">
                                <Label text="" />
                            </Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{outInvestingActs>account}" />
                                    <Text text="{outInvestingActs>value}" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                    <Table
                        id="otherAndTotalTableOut"
                        noDataText="Tidak ada data"
                        items="{outOtherAndTotal>/outOtherAndTotal}">
                        <columns>
                            <Column>
                                <Label text="" />
                            </Column>
                            <Column
                                hAlign="Center">
                                <Label text="" />
                            </Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{outOtherAndTotal>account}" />
                                    <Text text="{outOtherAndTotal>value}" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </VBox>
            </VBox>
        </content>
    </Page>
</mvc:View>