<mvc:View
	controllerName="lrlpapp.controller.laporan.Cashflow"
	xmlns:core="sap.ui.core"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:tnt="sap.tnt"
	xmlns:l="sap.ui.layout"
	xmlns:u="sap.ui.unified"
	xmlns:upload="sap.m.upload"
	xmlns="sap.m"
>
	<tnt:ToolPage id="app">
		<tnt:header>
			<tnt:ToolHeader>
				<Title
					id="cashflowToolbar"
					text="Cashflow Report Citiwalk"
				/>
			</tnt:ToolHeader>
		</tnt:header>
		<tnt:mainContents>
			<App
				id="main"
				class="app-container"
				mobileWebAppCapable="true"
			>
				<Page
					id="Home"
					title="Cashflow Report Citiwalk"
					titleLevel="H6"
					showHeader="false"
					class="main-container sapUiContentPadding sapUiResponsivePadding--content"
				>
					<content>
						<!-- <VBox class="centered"> -->
						<FlexBox>
							<VBox class="content">
								<VBox
									class="sapUiMediumMarginBeginEnd"
									justifyContent="SpaceBetween"
								>
									<Label
										text="Reporting Year "
										labelFor="fiscalYear"
									/>
									<HBox>
										<ComboBox
											id="fiscalYear"
											selectedKey="2023"
											required="true"
											width="60%"
										>
											<core:Item
												key="2023"
												text="2023"
											/>
											<core:Item
												key="2022"
												text="2022"
											/>
											<core:Item
												key="2021"
												text="2021"
											/>
											<core:Item
												key="2020"
												text="2020"
											/>
										</ComboBox>
										<Button
											type="Emphasized"
											text="Next"
											press="onClickNext"
											class="buttonPost"
											justifyContent="SpaceBetween"
										/>
									</HBox>
								</VBox>
							</VBox>
						</FlexBox>
					</content>
				</Page>
			</App>
		</tnt:mainContents>
	</tnt:ToolPage>
</mvc:View>
