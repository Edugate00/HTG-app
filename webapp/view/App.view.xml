<mvc:View
	xmlns:core="sap.ui.core"
	controllerName="lrlpapp.controller.App"
	xmlns:html="http://www.w3.org/1999/xhtml"
	xmlns:mvc="sap.ui.core.mvc"
	displayBlock="true"
	xmlns="sap.m">
	<VBox height="100vh">
		<HBox class="navbar">
			<HBox class="navbrand">
				<Image
					src="../zlorena_app/assets/LOGO-LORENA-PNG.png"
					width="40px"
					height="40px"
					alt="Logo-lorena" />
			</HBox>
			<HBox class="navDesktop">
				<HBox class="nav-links">
					<Link
						id="dashbaord"
						class="nav-link"
						text="Dashboard"
						press="onDashboardPress" />
					<Link
						id="utility"
						class="nav-link"
						text="Utility"
						press="onUtilityPress" />
					<Link
						id="rental"
						class="nav-link"
						text="Rental"
						press="onRentalPress" />
				</HBox>
			</HBox>
			<HBox
				alignItems="Center"
				height="auto"
				width="auto">
				<Avatar
					id="setting"
					src="sap-icon://action-settings"
					displaySize="Custom"
					customDisplaySize="2.2rem"
					backgroundColor="TileIcon"
					press="OnSetting" />

			</HBox>
		</HBox>
		<App id="mainContents" />
		<HBox class="navMobile">
			<VBox
				id="navMobileDashboard"
				class="navMobile-link">
				<core:Icon
					src="sap-icon://home"
					class="sizeNavIcon"
					color="#ffffff" />
				<Text
					class="navMobile-text"
					text="Dashboard" />
			</VBox>
			<VBox
				id="navMobileUtility"
				class="navMobile-link">
				<core:Icon
					src="sap-icon://blur"
					class="sizeNavIcon"
					color="#ffffff" />
				<Text
					class="navMobile-text"
					text="Utility" />
			</VBox>
			<VBox
				id="navMobileRental"
				class="navMobile-link">
				<core:Icon
					src="sap-icon://building"
					class="sizeNavIcon"
					color="#ffffff" />
				<Text
					class="navMobile-text"
					text="Rental" />
			</VBox>
		</HBox>
	</VBox>
</mvc:View>