<mvc:View
    xmlns:core="sap.ui.core"
    controllerName="lrlpapp.controller.App"
    xmlns:html="http://www.w3.org/1999/xhtml"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true"
    xmlns="sap.m">
    <VBox height="100vh">
        <HBox class="navbar">
            <HBox class="navbrand">
                <Image
                    src="../zlrlp_app/assets/LOGO-LORENA-PROPERTI.png"
                    width="40px"
                    height="40px"
                    alt="Logo-lorena" />
            </HBox>
            <HBox class="navDesktop">
                <HBox class="nav-links">
                    <Link
                        id="dashbaord"
                        class="nav-link"
                        text="Dashboard"
                        press="onDashboardPress" />
                    <Link
                        id="utility"
                        class="nav-link"
                        text="Air/Listrik"
                        press="onUtilityPress" />
                    <Link
                        id="rental"
                        class="nav-link"
                        text="Sewa"
                        press="onRentalPress" />
                    <!-- <Link
                        id="report"
                        class="nav-link"
                        text="Report"
                        press="onReportPress" /> -->
                    <MenuButton text ="Laporan" id = "report">
                        <menu>
                            <Menu itemSelected="onMenuAction" >
                                <MenuItem text="Profit &amp; Lost" />
                                <MenuItem text="Cash Flow" />
                                <MenuItem text="Balance Sheet" />
                                <!-- <MenuItem text="Tenant AR" /> -->
                            </Menu>
                        </menu>
                    </MenuButton>
                </HBox>
            </HBox>
            <HBox
                alignItems="Center"
                height="auto"
                width="auto">
                <Text id="userName" class="sapUiSmallMarginBeginEnd userName" />
                <Avatar
                    id="userImg"
                    src="sap-icon://action-settings"
                    displaySize="Custom"
                    customDisplaySize="2.2rem"
                    backgroundColor="TileIcon"
                    press="OnSetting" />

            </HBox>
        </HBox>
        <App id="mainContents" height="100%" />
        <!-- <Button class="refresh-btn" icon="sap-icon://refresh" /> -->
        <HBox
            class="refresh-btn"
            alignItems="Center"
            height="auto"
            width="auto">
            <Avatar
                id="refresh"
                src="sap-icon://refresh"
                displaySize="Custom"
                customDisplaySize="3rem"
                backgroundColor="Accent8"
                press="OnRefresh" />
        </HBox>
        <HBox class="navMobile">
            <VBox
                id="navMobileDashboard"
                class="navMobile-link">
                <core:Icon
                    src="sap-icon://home"
                    class="sizeNavIcon"
                    color="#ffffff" />
                <Text
                    class="navMobile-text"
                    text="Dashboard" />
            </VBox>
            <VBox
                id="navMobileUtility"
                class="navMobile-link">
                <core:Icon
                    src="sap-icon://blur"
                    class="sizeNavIcon"
                    color="#ffffff" />
                <Text
                    class="navMobile-text"
                    text="Air/Listrik" />
            </VBox>
            <VBox
                id="navMobileRental"
                class="navMobile-link">
                <core:Icon
                    src="sap-icon://building"
                    class="sizeNavIcon"
                    color="#ffffff" />
                <Text
                    class="navMobile-text"
                    text="Sewa" />
            </VBox>
        </HBox>
    </VBox>
</mvc:View>