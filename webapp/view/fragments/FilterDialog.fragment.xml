<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog
        id="filterDialog"
        title="Filter"
        type="Standard">
        <content>
            <VBox class="card-content" width="100%" height="100%">
                <VBox width="100%" class="sapUiSmallMarginBottom">
                    <Label text="Tenant" />
                    <ComboBox
                        id="tenantList"
                        width="100%"
                        selectedKey="*"
                        items="{tenant>/tenant}"
                        class="sapUiTinyMarginEnd sapMCbAutoFocus">
                        <core:ListItem
                            key="{tenant>KodeTenant}"
                            text="{tenant>NamaTenant}" />
                    </ComboBox>
                </VBox>
                <VBox width="100%" class="sapUiSmallMarginBottom">
                    <Label labelFor="rbg2" text="Status Pembayaran" />
                    <RadioButtonGroup selectedKey="0" id="rbg2" width="100%">
                        <RadioButton id="RB2-0" key="0" text="Semua Status" />
                        <RadioButton id="RB2-1" key="1" text="Sudah dibayar" />
                        <RadioButton id="RB2-2" key="2" text="Belum dibayar" />
                    </RadioButtonGroup>
                </VBox>
                <VBox width="100%" class="sapUiSmallMarginBottom">
                    <Label text="Periode" />
                    <ComboBox
                        id="filterPeriod"
                        width="100%"
                        selectedKey="*"
                        class="sapUiTinyMarginEnd sapMCbAutoFocus">
                        <core:Item
                            key="*"
                            text="Semua Periode" />
                        <core:Item
                            key="01"
                            text="Januari" />
                        <core:Item
                            key="02"
                            text="Februari" />
                        <core:Item
                            key="00"
                            text="Maret" />
                        <core:Item
                            key="04"
                            text="April" />
                        <core:Item
                            key="05"
                            text="Mei" />
                        <core:Item
                            key="06"
                            text="Juni" />
                        <core:Item
                            key="07"
                            text="Juli" />
                        <core:Item
                            key="08"
                            text="Agustus" />
                        <core:Item
                            key="09"
                            text="September" />
                        <core:Item
                            key="10"
                            text="Oktober" />
                        <core:Item
                            key="11"
                            text="November" />
                        <core:Item
                            key="12"
                            text="Desember" />
                    </ComboBox>
                </VBox>
                <VBox width="100%" class="sapUiSmallMarginBottom">
                    <Label labelFor="rbg3" text="Urutkan Nilai Sewa" />
                    <RadioButtonGroup id="rbg3" columns="2" width="100%"
                        selectedIndex="1"
                    >
                        <RadioButton id="RB3-1" text="Tertinggi" />
                        <RadioButton id="RB3-2" text="Terendah" />
                    </RadioButtonGroup>
                </VBox>
            </VBox>
        </content>
        <beginButton>
            <Button
                text="Tutup"
                type="Default"
                press="onFilterDialogClose" />
        </beginButton>
        <endButton>
            <Button
                text="Terapkan Filter"
                type="Emphasized"
                press="onApplyFIlter" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>