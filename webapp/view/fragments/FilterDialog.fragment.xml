<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog
        id="filterDialog"
        title="Filter"
        type="Standard"
        contentHeight="400px">
        <content>
            <VBox class="card-content" width="100%" height="100%">
                <VBox width="100%" class="sapUiSmallMarginBottom">
                    <Label labelFor="rbg1" text="Tenant" />
                    <RadioButtonGroup id="rbg1" columns="2" width="100%">
                        <RadioButton id="RB1-0" text="Semua Tenant" />
                        <RadioButton id="RB1-1" text="Butterfield" />
                        <RadioButton id="RB1-2" text="Karimata" />
                        <RadioButton id="RB1-3" text="Sharinc" />
                        <RadioButton id="RB1-4" text="Woori" />
                    </RadioButtonGroup>
                </VBox>
                <VBox width="100%" class="sapUiSmallMarginBottom">
                    <Label labelFor="rbg2" text="Status Pembayaran" />
                    <RadioButtonGroup id="rbg2" width="100%">
                        <RadioButton id="RB2-0" text="Semua Status" />
                        <RadioButton id="RB2-1" text="Sudah dibayar" />
                        <RadioButton id="RB2-2" text="Belum dibayar" />
                    </RadioButtonGroup>
                </VBox>
                <VBox width="100%" class="sapUiSmallMarginBottom">
                    <Label labelFor="rbg3" text="Urutkan" />
                    <RadioButtonGroup id="rbg3" columns="2" width="100%">
                        <RadioButton id="RB3-1" text="Ascending" />
                        <RadioButton id="RB3-2" text="Descending" />
                    </RadioButtonGroup>
                </VBox>
            </VBox>
        </content>
        <beginButton>
            <Button
                text="Tutup"
                type="Default"
                press="onFilterDialogClose" />
        </beginButton>
        <endButton>
            <Button
                text="Terapkan Filter"
                type="Emphasized"
                press="onApplyFIlter" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>