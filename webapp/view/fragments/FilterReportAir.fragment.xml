<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <Dialog id="filterDialog" title="Filter">
        <content>
            <List id="filterList" items="{path: '/items'}">
                <items>
                    <CustomListItem type="Active" press="onFilterSelect">
                        <content>
                            <RadioButton text="{Name}" selected="{Selected}" />
                        </content>
                    </CustomListItem>
                </items>
            </List>
        </content>
        <beginButton>
            <Button text="Cancel" press="onCancelFilter" />
        </beginButton>
        <endButton>
            <Button text="Apply" type="Emphasized" press="onApplyFilter" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>