<c:FragmentDefinition
    xmlns="sap.m"
    xmlns:c="sap.ui.core">
    <Dialog
        id="tagihanSewaDialog"
        title="Tagihan Sewa untuk dirilis"
        type="Standard"
        afterClose="onAfterCloseTagihanSewaDialog"
        contentHeight="400px">
        <content>
            <List
                id="listTagihanSewa"
                items="{tagihanSewa>/tagihanSewa}"
                mode="SingleSelectLeft"
                includeItemInSelection="true">
                <StandardListItem
                    type="Active"
                    title="{tagihanSewa>BillingNumber} - {tagihanSewa>CustomerDesc}"
                    description="{tagihanSewa>MaterialDesc}"
                    info="{tagihanSewa>BillingDate}"
                    infoState="Default" />
            </List>
        </content>
        <beginButton>
            <Button
                text="Tutup"
                type="Default"
                press="onTagihanSewaDialogClose" />
        </beginButton>
        <endButton>
            <Button
                text="Rilis Tagihan"
                type="Emphasized"
                press="onTagihanSewaDialogRelease" />
        </endButton>
    </Dialog>
</c:FragmentDefinition>