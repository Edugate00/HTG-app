<c:FragmentDefinition
    xmlns="sap.m"
    xmlns:c="sap.ui.core">
    <Dialog
        id="tagihanSewaDialog"
        title="Tagihan Sewa untuk dicetak"
        type="Standard"
        contentHeight="400px">
        <content>
            <List
                id="listTagihanSewa"
                items="{tagihanAir>/tagihanAir}"
                mode="MultiSelect"
                includeItemInSelection="true">
                <StandardListItem
                    type="Active"
                    title="{tagihanAir>noTagihan} - {tagihanAir>nama}"
                    description="{tagihanAir>dueDate}" />
            </List>
        </content>
        <beginButton>
            <Button
                text="Close"
                type="Default"
                press="onTagihanSewaDialogClose" />
        </beginButton>
        <endButton>
            <Button
                text="Release"
                type="Emphasized"
                press="onTagihanSewaDialogRelease" />
        </endButton>
    </Dialog>
</c:FragmentDefinition>