<c:FragmentDefinition
    xmlns="sap.m"
    xmlns:c="sap.ui.core">
    <Dialog
        id="tagihanSewaDialog"
        title="Tagihan Sewa untuk dicetak"
        type="Standard"
        contentHeight="400px">
        <content>
            <List
                id="listTagihanSewa"
                items="{tagihanSewa>/tagihanSewa}"
                mode="MultiSelect"
                includeItemInSelection="true">
                <StandardListItem
                    type="Active"
                    title="{tagihanSewa>BillingNumber} - {tagihanSewa>CustomerDesc}"
                    description="{tagihanSewa>BillingDate}"
                    info="{tagihanSewa>Info}"
                    infoState="{tagihanSewa>InfoState}" />
            </List>
        </content>
        <beginButton>
            <Button
                text="Tutup"
                type="Default"
                press="onTagihanSewaDialogClose" />
        </beginButton>
        <endButton>
            <Button
                text="Rilis Tagihan"
                type="Emphasized"
                press="onTagihanSewaDialogRelease" />
        </endButton>
    </Dialog>
</c:FragmentDefinition>