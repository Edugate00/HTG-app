<c:FragmentDefinition
    xmlns="sap.m"
    xmlns:c="sap.ui.core">
    <Dialog
        id="belumCetakDialog"
        title="Tagihan belum dicetak"
        type="Standard"
        contentHeight="400px">
        <content>
            <List
                id="listBelumCetak"
                items="{belumCetak>/belumCetak}"
                mode="SingleSelectLeft"
                includeItemInSelection="true">
                <StandardListItem
                    type="Active"
                    title="{belumCetak>BillingNumber} - {belumCetak>CustomerDesc}"
                    description="{belumCetak>MaterialDesc}"
                    info="{belumCetak>BillingDate}"
                    infoState="Default" />
            </List>
        </content>
        <beginButton>
            <Button
                text="Close"
                type="Default"
                press="onBelumCetakDialogClose" />
        </beginButton>
        <endButton>
            <Button
                text="Cetak"
                type="Emphasized"
                press="onBelumCetakDialogCetak" />
        </endButton>
    </Dialog>
</c:FragmentDefinition>