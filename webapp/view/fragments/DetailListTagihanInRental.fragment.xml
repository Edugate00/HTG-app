<c:FragmentDefinition
    xmlns="sap.m"
    xmlns:c="sap.ui.core">
    <Dialog
        id="detailListTagihan"
        title="Detail Tagihan"
        contentWidth="480px"
        type="Standard">
        <content>
            <FlexBox
                direction="Column"
                items="{tagihan>/detailTagihan}">
                <VBox class="card-content">
                    <VBox width="100%">
                        <FormattedText
                            htmlText="Tenant"
                            class="small-label" />
                        <FormattedText
                            htmlText="{tagihan>CustomerDesc}"
                            class="sub-heading" />
                    </VBox>
                    <FlexBox class="sapUiSmallMarginTop" justifyContent="SpaceBetween">
                        <VBox width="100%">
                            <FormattedText
                                htmlText="Nomor"
                                class="small-label" />
                            <FormattedText
                                htmlText="{tagihan>BillingNumber}"
                                class="sub-heading" />
                        </VBox>
                        <VBox width="100%">
                            <FormattedText
                                htmlText="Jenis Tagihan"
                                class="small-label" />
                            <FormattedText
                                htmlText="{tagihan>MaterialDesc}"
                                class="sub-heading" />
                        </VBox>
                    </FlexBox>
                    <FlexBox class="sapUiSmallMarginTop" justifyContent="SpaceBetween">
                        <VBox width="100%">
                            <FormattedText
                                htmlText="Tanggal"
                                class="small-label" />
                            <FormattedText
                                htmlText="{tagihan>BillingDate}"
                                class="sub-heading" />
                        </VBox>
                        <VBox width="100%">
                            <FormattedText
                                htmlText="Tenggat Waktu"
                                class="small-label" />
                            <FormattedText
                                htmlText="{tagihan>DueDate}"
                                class="sub-heading" />
                        </VBox>
                    </FlexBox>
                    <FlexBox class="sapUiSmallMarginTop" justifyContent="SpaceBetween">
                        <VBox width="100%">
                            <FormattedText
                                htmlText="Nilai Tagihan"
                                class="small-label" />
                            <FormattedText
                                htmlText="Rp {tagihan>NetValue}"
                                class="sub-heading" />
                        </VBox>

                        <VBox width="100%">
                            <FormattedText
                                htmlText="Status Pembayaran"
                                class="small-label" />
                            <FormattedText
                                htmlText="{tagihan>Status}"
                                class="sub-heading" />
                        </VBox>
                    </FlexBox>
                    <FlexBox class="sapUiSmallMarginTop" justifyContent="SpaceBetween">
                        <VBox width="100%">
                            <FormattedText
                                htmlText="Tanggal Pembayaran"
                                class="small-label" />
                            <FormattedText
                                htmlText="{tagihan>PaymentDate}"
                                class="sub-heading" />
                        </VBox>
                        <VBox width="100%">
                            <FormattedText
                                htmlText="Periode"
                                class="small-label" />
                            <FormattedText
                                htmlText="{tagihan>PriceListDesc}"
                                class="sub-heading" />
                        </VBox>
                    </FlexBox>
                </VBox>
            </FlexBox>
        </content>
        <beginButton>
            <Button
                text="Tutup"
                type="Default"
                press="onDetailTagihanClose" />
        </beginButton>
    </Dialog>
</c:FragmentDefinition>