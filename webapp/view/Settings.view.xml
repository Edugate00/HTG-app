<mvc:View
    controllerName="lrlpapp.controller.Settings"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:uxap="sap.uxap"
    xmlns="sap.m">
    <Page showHeader="false">
        <VBox class="header-container" />
        <VBox class="main-container">
            <VBox class="card">
                <uxap:ObjectPageLayout id="settings">
                    <uxap:headerTitle>
                        <uxap:ObjectPageDynamicHeaderTitle>
                            <uxap:expandedHeading>
                                <Title text="Object Page Header with Header Container"
                                    wrapping="true" />
                            </uxap:expandedHeading>

                            <uxap:snappedHeading>
                                <HBox>
                                    <VBox>
                                        <Avatar
                                            src=""
                                            class="sapUiSmallMarginEnd" />
                                    </VBox>

                                    <VBox>
                                        <Title text="Object Page Header with Header Container"
                                            wrapping="true" />
                                        <Label text="Example of an ObjectPage with header facet" />
                                    </VBox>
                                </HBox>
                            </uxap:snappedHeading>
                            <uxap:expandedContent>
                                <Label text="Example of an ObjectPage with header facet" />
                            </uxap:expandedContent>
                            <uxap:snappedTitleOnMobile>
                                <Title text="Object Page Header with Header Container" />
                            </uxap:snappedTitleOnMobile>
                            <uxap:actions>
                                <Button text="Edit" type="Emphasized" />
                            </uxap:actions>
                        </uxap:ObjectPageDynamicHeaderTitle>
                    </uxap:headerTitle>
                </uxap:ObjectPageLayout>
            </VBox>
        </VBox>
    </Page>
</mvc:View>