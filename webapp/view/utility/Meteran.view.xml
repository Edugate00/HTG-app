<mvc:View
	controllerName="lrlpapp.controller.utility.Meteran"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:ndc="sap.ndc"
	xmlns="sap.m"
>
	<Page showHeader="false">
		<HBox class="header-container">
			<Button
				text="Back"
				icon="sap-icon://nav-back"
				press="onNavBack"
			/>
			<Title
				class="sapUiSmallMarginBegin"
				text="Pindai Meteran"
			/>
		</HBox>
		<FlexBox
			class="main-container "
			height="600px"
			justifyContent="Center"
		>
			<VBox class="card">
				<HBox class="card-header">
					<Text
						class="card-title"
						text="Pengukuran Nilai"
					/>
				</HBox>
				<VBox class="sapUiMediumMarginBeginEnd">
					<VBox class="sapUiSmallMarginTopBottom">
						<Title text="Tanggal dan Jam"/>
						<Text
							id="CurrentMeasDateTime"
							text="-"
						/>
					</VBox>
					<VBox class="sapUiSmallMarginTopBottom">
						<Title text="Kode Pengukuran"/>
						<FlexBox direction="Row">
							<Input
								id="CurrentMeasPoint"
								type="Number"
								placeholder="Input / Scan"
							/>
							<ndc:BarcodeScannerButton
								id="barcodeScannerDialog"
								class="sapUiSmallMarginBeginEnd"
								scanSuccess="onScanSuccess"
								scanFail="onScanError"
							/>
						</FlexBox>
					</VBox>
					<VBox class="sapUiSmallMarginTopBottom">
						<Title text="Deskripsi"/>
						<Text text="LRLP-CITIWALK-CONTAINER_1A"/>
					</VBox>
					<VBox class="sapUiSmallMarginTopBottom">
						<Title text="Nilai Pengukuran Sebelumnya"/>
						<HBox>
							<Text text="12.701 L"/>
							<Text
								class="sapUiSmallMarginBegin"
								text="13-02-2023 / 15:00:00"
							/>
						</HBox>
					</VBox>
					<VBox class="sapUiSmallMarginTopBottom">
						<FlexBox direction="Row">
							<VBox>
								<Title text="Nilai Pengukuran Saat ini"/>
								<Input
									id="CurrentMeasValue"
									type="Number"
									enabled="false"
									placeholder="Input Measurement Value"
								/>
							</VBox>
							<VBox class="sapUiSmallMarginBegin"/>
						</FlexBox>
					</VBox>
					<VBox class="sapUiSmallMarginTopBottom">
						<VBox>
							<Title text="Total Pemakaian (Air/Listrik)"/>
							<Text text="13.800 L"/>
						</VBox>
					</VBox>
					<HBox>
						<Button
							text="Simpan Pengukuran"
							type="Emphasized"
							press="OnPostMeasurement"
						/>
					</HBox>
				</VBox>
			</VBox>
		</FlexBox>
	</Page>
</mvc:View>