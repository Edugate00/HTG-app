<mvc:View
	controllerName="lrlpapp.controller.utility.ReportAir"
	xmlns="sap.m"
	xmlns:f="sap.f"
	xmlns:l="sap.ui.layout"
	xmlns:core="sap.ui.core"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:smartList="sap.ui.comp.smartlist"
	xmlns:custom="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">

	<App>
		<Page
			id="measdoc"
			title="Pemakaian Air - Measurement Documents List"
			backgroundDesign="List"
			class="sapUiResponsivePadding--subHeader">
			<headerContent>
				<Button icon="sap-icon://filter" tooltip="Filter" press="openFilterDialog" />
			</headerContent>
				<List
					id="measdocList"
					busyIndicatorDelay="500"
					enableBusyIndicator="true"
					noDataText="No Data Available"
					selectionChange=".onListItemPress"
					items="{
						path: 'MeasPoint>/measPointList/'
					}"
					mode="SingleSelectMaster">
							<StandardListItem 
								title="{MeasPoint>Text}"
								description="{MeasPoint>Description} - {MeasPoint>Document} - {MeasPoint>Date}"
								info="{MeasPoint>Value} {MeasPoint>Unit}" />
				</List>
		</Page>
	</App>
   
</mvc:View>