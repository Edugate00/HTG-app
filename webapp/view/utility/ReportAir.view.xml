<mvc:View
    controllerName="htgapp.controller.utility.ReportAir"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
    xmlns:ListItem="sap.ui.core.Item"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:smartList="sap.ui.comp.smartlist"
    xmlns:custom="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">

    <Page showHeader="false">
        <VBox class="header-container">

        </VBox>
        <VBox class="main-container">
            <FlexBox width="100%" justifyContent="Center">
                <VBox class="card card-reportair">
                    <FlexBox
                        class="card-header">
                        <Text
                            class="card-title"
                            text="Pemakaian Air" />
                        <HBox>
                            <ComboBox
                                id="ComboBoxFilterTenant"
                                width="150px"
                                placeholder="Pilih Tenant"
                                selectionChange="onTenantFilter"
                                selectedKey="*"
                                class="sapUiTinyMarginEnd sapMCbAutoFocus"
                                items="{Tenant>/tenantList}"
                                >
                                <core:Item key="{Tenant>id}"
									text="{Tenant>name}" />

                            </ComboBox>
                            <ComboBox
                                id="ComboBoxFilterMonth"
                                width="150px"
                                selectionChange="onMonthFilter"
                                selectedKey="*"
                                class="sapMCbAutoFocus">
                                <core:Item
                                    key="*"
                                    text="Semua Periode" />
                                <core:Item
                                    key="Januari"
                                    text="Januari" />
                                <core:Item
                                    key="Februari"
                                    text="Februari" />
                                <core:Item
                                    key="Maret"
                                    text="Maret" />
                                <core:Item
                                    key="April"
                                    text="April" />
                                <core:Item
                                    key="Mei"
                                    text="Mei" />
                                <core:Item
                                    key="Juni"
                                    text="Juni" />
                                <core:Item
                                    key="Juli"
                                    text="Juli" />
                                <core:Item
                                    key="Agustus"
                                    text="Agustus" />
                                <core:Item
                                    key="September"
                                    text="September" />
                                <core:Item
                                    key="Oktober"
                                    text="Oktober" />
                                <core:Item
                                    key="November"
                                    text="November" />
                                <core:Item
                                    key="Desember"
                                    text="Desember" />
                            </ComboBox>
                        </HBox>
                    </FlexBox>
                    <ScrollContainer
                        height="90%"
                        vertical="true">
                        <List
                            id="measdocList"
                            busyIndicatorDelay="500"
                            enableBusyIndicator="true"
                            noDataText="No Data Available"
                            selectionChange=".onListItemPress"
                            items="{
								path: 'MeasPoint>/measPointList/'
							}"
                            mode="SingleSelectMaster">
                            <items>
                                <ObjectListItem
                                    type="Active"
                                    title="{MeasPoint>Text}">
                                    <ObjectAttribute
                                        title="Tgl/Jam"
                                        text="{MeasPoint>Date} / {MeasPoint>Time}" />
                                    <ObjectAttribute
                                        title="Container"
                                        text="{MeasPoint>Description} - {MeasPoint>Document}" />
                                    <secondStatus>
                                        <ObjectStatus
                                            text="{MeasPoint>Value} {MeasPoint>Unit}" />
                                    </secondStatus>
                                </ObjectListItem>
                            </items>
                        </List>
                    </ScrollContainer>
                </VBox>
            </FlexBox>
        </VBox>
    </Page>
</mvc:View>