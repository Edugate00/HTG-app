		<masterPages>
			<Page
				id="measdoc"
				title="Mesurement Documents"
				backgroundDesign="List"
				class="sapUiResponsivePadding--subHeader">
				<headerContent>
					<Button icon="sap-icon://filter" tooltip="Filter" press="openFilterDialog" />
				</headerContent>
                <List
					id="measdocList"
					busyIndicatorDelay="500"
					enableBusyIndicator="true"
					noDataText="No Data Available"
					selectionChange=".onListItemPress"
					items="{
						path: 'MeasDoc',
						sorter: {
							path: 'Document',
							group: true
						}
					}"
					mode="SingleSelectMaster">
					<items>
						<StandardListItem
							title="{MeasDoc>Document}"
							description=""
							type="Active"
							custom:to="detail" />
					</items>
				</List>
                
				
			</Page>
		</masterPages>
		<detailPages>
			<Page
				id="detail"
				title="Pemakaian Air Bulanan"
				backgroundDesign="Solid"
				showHeader="true"
				showFooter="true" 
				class="sapUiResponsivePadding--header">
					<ObjectHeader
					title="{selectedActivity>/Description}"
					backgroundDesign="Solid"
					responsive="false"
					fullScreenOptimized="true">

					<attributes>
						
