<mvc:View
	controllerName="lrlpapp.controller.utility.ReportAir"
	xmlns="sap.m"
	xmlns:f="sap.f"
	xmlns:l="sap.ui.layout"
	xmlns:core="sap.ui.core"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:smartList="sap.ui.comp.smartlist"
	xmlns:custom="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">

	<Page showHeader="false">
		<VBox class="header-container">

		</VBox>
		<VBox class="main-container"> 
			<FlexBox width="100%"  justifyContent="Center" >
				<VBox class="card card-reportair">
					<FlexBox
						class="card-header">
						<Text
							class="card-title"
							text="Pemakaian Air" />
						<HBox>
							<ComboBox
								id="ComboBoxFilterTenant"
								width="132px"
								placeholder="Pilih Tenant"
								selectionChange="onTenantFilter"
								selectedKey="*"
								class="sapUiTinyMarginEnd sapMCbAutoFocus">
								<core:Item
									key="*"
									text="Semua Tenant" />
								<core:Item
									key="Karimata"
									text="Karimata" />
								<core:Item
									key="Butterfield"
									text="Butterfield" />
								<core:Item
									key="Woori"
									text="Woori" />
								<core:Item
									key="Sharinc"
									text="Sharinc" />
							</ComboBox>
							<ComboBox
								id="ComboBoxFilterMonth"
								width="132px"
								placeholder="Select Status"
								selectionChange="onMonthFilter"
								selectedKey="*"
								class="sapMCbAutoFocus">
								<core:Item
									key="*"
									text="Semua" />
								<core:Item
									key="01"
									text="Januari" />
								<core:Item
									key="02"
									text="Februari" />
							</ComboBox>
						</HBox>
					</FlexBox>
					<ScrollContainer
						height="90%"
						vertical="true">
						<List
							id="measdocList"
							busyIndicatorDelay="500"
							enableBusyIndicator="true"
							noDataText="No Data Available"
							selectionChange=".onListItemPress"
							items="{
								path: 'MeasPoint>/measPointList/'
							}"
							mode="SingleSelectMaster">
							<items>
								<ObjectListItem
									type="Active"
									title="{MeasPoint>Text}">
									<ObjectAttribute
											title="Tgl/Jam"
											text="{MeasPoint>Date} / {MeasPoint>Time}" />
									<ObjectAttribute
											title="Container"
											text="{MeasPoint>Description} - {MeasPoint>Document}" />
									<secondStatus>
										<ObjectStatus
											text="{MeasPoint>Value} {MeasPoint>Unit}" />
									</secondStatus>
								</ObjectListItem>
							</items>
						</List>
					</ScrollContainer>
				</VBox>
			</FlexBox>
		</VBox>
	</Page>
	</mvc:View>