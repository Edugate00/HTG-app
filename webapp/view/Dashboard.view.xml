<mvc:View
    controllerName="lrlpapp.controller.Dashboard"
    xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    xmlns:viz.data="sap.viz.ui5.data"
>
    <Page showHeader="false">
        <VBox class="header-container" />
        <VBox class="main-container">
            <HBox class="tiles">
                <VBox
                    class="tile"
                    id="tilePindaiMeteran">
                    <FlexBox class="tile-header">
                        <VBox class="tile-icon sapUiSmallMarginEnd">
                            <core:Icon
                                src="sap-icon://qr-code"
                                class="size1"
                                color="#ffffff" />
                        </VBox>
                        <Text
                            class="tile-title"
                            text="Pindai Meteran" />
                    </FlexBox>
                    <VBox class="tile-info">
                        <FlexBox alignItems="Center" items="{notif>/notif}">
                            <Text
                                class="dynamic-number"
                                text="{notif>pindaiMeteran}" />
                        </FlexBox>
                        <HBox items="{notif>/notif}">
                            <Text text="{notif>pindaiMeteranDesc}" />
                        </HBox>
                    </VBox>
                </VBox>
                
                <VBox
                    class="tile"
                    id="tileTagihanSewa">
                    <FlexBox class="tile-header">
                        <VBox class="tile-icon sapUiSmallMarginEnd">
                            <core:Icon
                                src="sap-icon://building"
                                class="size1"
                                color="#ffffff" />
                        </VBox>
                        <Text
                            class="tile-title"
                            text="Tagihan Sewa" />
                    </FlexBox>
                    <VBox class="tile-info">
                        <FlexBox alignItems="Center" items="{notif>/notif}">
                            <Text
                                class="dynamic-number"
                                text="{notif>tagihanSewa}" />
                        </FlexBox>
                        <Text text="Tagihan untuk dibuat" />
                    </VBox>
                </VBox>
                <VBox
                    class="tile tile-danger"
                    id="tileBelumCetak">
                    <FlexBox class="tile-header">
                        <VBox class="tile-icon sapUiSmallMarginEnd">
                            <core:Icon
                                src="sap-icon://sales-order-item"
                                class="size1"
                                color="#ffffff" />
                        </VBox>
                        <Text
                            class="tile-title"
                            text="Belum Dicetak" />
                    </FlexBox>
                    <VBox class="tile-info">
                        <FlexBox alignItems="Center" items="{notif>/notif}">
                            <Text
                                class="dynamic-number"
                                text="{notif>belumCetak}" />
                        </FlexBox>
                        <Text text="Tagihan untuk dicetak" />
                    </VBox>
                </VBox>
            </HBox>
            <HBox class="bills-and-utility">
                <VBox class="card-tagihan card">
                    <FlexBox
                        class="card-header" justifyContent="SpaceBetween">
                        <Text
                            class="card-title"
                            text="Tagihan Tercetak" />
                        <Button icon="sap-icon://filter" press="openFilterDialog" />
                    </FlexBox>
                    <ScrollContainer
                        height="90%"
                        vertical="true">
                        <List
                            id="tagihanList"
                            items="{tagihan>/tagihan}">
                            <items>
                                <ObjectListItem
                                    type="Active"
                                    number="{tagihan>NetValue}"
                                    numberUnit="IDR"
                                    press="onSelectListTagihan"
                                    title="{tagihan>BillingNumber} - {tagihan>CustomerDesc}">
                                    <ObjectAttribute
                                        title="Jenis Tagihan"
                                        text="{tagihan>MaterialDesc}" />
                                    <ObjectAttribute
                                        title="Tanggal"
                                        text="{tagihan>BillingDate}" />
                                    <secondStatus>
                                        <ObjectStatus
                                            text="{tagihan>Status}"
                                            state="{tagihan>TipeStatus}" />
                                    </secondStatus>
                                </ObjectListItem>
                            </items>
                        </List>
                    </ScrollContainer>
                </VBox>
                <VBox class="utility-charts">
                    <VBox class="card">
                        <FlexBox
                            class="card-header">
                            <Text
                                class="card-title"
                                text="Penggunaan Listrik" />
                            <HBox>
                                <ComboBox
                                    id="ListrikTimestampFilter"
                                    width="120px"
                                    placeholder="Pilih bulan"
                                    selectionChange="onListrikChartTimestamp"
                                    selectedKey="6bulan"
                                    class="sapUiTinyMarginEnd sapMCbAutoFocus">
                                    <core:Item
                                        key="6bulan"
                                        text="6 Bulan" />
                                    <core:Item
                                        key="1tahun"
                                        text="1 Tahun" />
                                    <core:Item
                                        key="*"
                                        text="Semua" />
                                </ComboBox>
                            </HBox>
                        </FlexBox>
                        <VBox height="100%">
                            <viz:VizFrame
                                id="vizPenggunaanListrik"
                                height="210px"
                                width="100%"
                                vizType="line"
                                busyIndicatorDelay="500"
                                legendVisible="false">
                                <viz:dataset>
                                    <viz.data:FlattenedDataset data="{penggunaanListrik>/data}">
                                        <viz.data:dimensions>
                                            <viz.data:DimensionDefinition
                                                name="Category"
                                                value="{penggunaanListrik>month}" />
                                        </viz.data:dimensions>
                                        <viz.data:measures>
                                            <viz.data:MeasureDefinition
                                                name="Value"
                                                value="{penggunaanListrik>value}" />
                                        </viz.data:measures>
                                    </viz.data:FlattenedDataset>
                                </viz:dataset>
                                <viz:feeds>
                                    <viz.feeds:FeedItem
                                        id="listrikValueAxisFeed"
                                        uid="valueAxis"
                                        type="Measure"
                                        values="Value" />
                                    <viz.feeds:FeedItem
                                        id="listrikCategoryAxisFeed"
                                        uid="categoryAxis"
                                        type="Dimension"
                                        values="Category" />
                                </viz:feeds>
                            </viz:VizFrame>
                        </VBox>
                    </VBox>
                </VBox>
            </HBox>
        </VBox>
    </Page>
</mvc:View>