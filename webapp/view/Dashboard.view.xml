<mvc:View
	controllerName="lrlpapp.controller.Dashboard"
	xmlns:core="sap.ui.core"
	xmlns:mvc="sap.ui.core.mvc"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:viz="sap.viz.ui5.controls"
	xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
	xmlns:viz.data="sap.viz.ui5.data"
>
	<Page showHeader="false">
		<VBox class="header-container" />
		<VBox class="main-container">
			<HBox class="tiles">
				<VBox
					class="tile"
					id="tilePindaiMeteran">
					<FlexBox class="tile-header">
						<VBox class="tile-icon sapUiSmallMarginEnd">
							<core:Icon
								src="sap-icon://qr-code"
								class="size1"
								color="#ffffff" />
						</VBox>
						<Text
							class="tile-title"
							text="Pindai Meteran Air" />
					</FlexBox>
					<VBox class="tile-info">
						<Text
							class="dynamic-number"
							text="0" />
						<Text text="Meteran perlu dipindai" />
					</VBox>
				</VBox>
				<VBox
					class="tile"
					id="tileTagihanAir">
					<FlexBox class="tile-header">
						<VBox class="tile-icon sapUiSmallMarginEnd">
							<core:Icon
								src="sap-icon://blur"
								class="size1"
								color="#ffffff" />
						</VBox>
						<Text
							class="tile-title"
							text="Tagihan Air" />
					</FlexBox>
					<VBox class="tile-info">
						<Text
							class="dynamic-number"
							text="5" />
						<Text text="Tagihan untuk dicetak" />
					</VBox>
				</VBox>
				<VBox
					class="tile"
					id="tileTagihanSewa">
					<FlexBox class="tile-header">
						<VBox class="tile-icon sapUiSmallMarginEnd">
							<core:Icon
								src="sap-icon://building"
								class="size1"
								color="#ffffff" />
						</VBox>
						<Text
							class="tile-title"
							text="Tagihan Sewa" />
					</FlexBox>
					<VBox class="tile-info">
						<Text
							class="dynamic-number"
							text="3" />
						<Text text="Tagihan untuk dicetak" />
					</VBox>
				</VBox>
				<VBox
					class="tile tile-danger"
					id="tileTagihanTerlambat">
					<FlexBox class="tile-header">
						<VBox class="tile-icon sapUiSmallMarginEnd">
							<core:Icon
								src="sap-icon://sales-order-item"
								class="size1"
								color="#ffffff" />
						</VBox>
						<Text
							class="tile-title"
							text="Terlambat Dicetak" />
					</FlexBox>
					<VBox class="tile-info">
						<Text
							class="dynamic-number"
							text="0" />
						<Text text="Tagihan untuk dicetak" />
					</VBox>
				</VBox>
			</HBox>
			<HBox class="bills-and-utility">
				<VBox class="card-tagihan card">
					<FlexBox
						class="card-header">
						<Text
							class="card-title"
							text="Tagihan" />
						<HBox>
							<ComboBox
								id="ComboBoxTagihanTenant"
								width="132px"
								placeholder="Pilih Tenant"
								selectionChange="onTagihanTenantSelected"
								selectedKey="*"
								class="sapUiTinyMarginEnd sapMCbAutoFocus">
								<core:Item
									key="*"
									text="Semua Tenant" />
								<core:Item
									key="Tenant A"
									text="Tenant A" />
								<core:Item
									key="Tenant B"
									text="Tenant B" />
								<core:Item
									key="Tenant C"
									text="Tenant C" />
								<core:Item
									key="Tenant D"
									text="Tenant D" />
								<core:Item
									key="Tenant E"
									text="Tenant E" />
								<core:Item
									key="Tenant F"
									text="Tenant F" />
							</ComboBox>
							<ComboBox
								id="ComboBoxTagihanStatus"
								width="132px"
								placeholder="Select Status"
								selectionChange="onStatusSelect"
								selectedKey="*"
								class="sapMCbAutoFocus">
								<core:Item
									key="*"
									text="Semua" />
								<core:Item
									key="paid"
									text="Sudah dibayar" />
								<core:Item
									key="unpaid"
									text="Belum dibayar" />
							</ComboBox>
						</HBox>
					</FlexBox>
					<ScrollContainer
						height="90%"
						vertical="true">
						<List
							id="tagihanList"
							items="{tagihan>/tagihan}">
							<items>
								<ObjectListItem
									type="Active"
									title="{tagihan>noTagihan} - {tagihan>tenant}">
									<ObjectAttribute
										title="Tipe"
										text="{tagihan>tipe}" />
									<ObjectAttribute
										title="Tanggal"
										text="{tagihan>dueDate}" />
									<secondStatus>
										<ObjectStatus
											text="{tagihan>status}"
											state="{tagihan>tipeStatus}" />
									</secondStatus>
								</ObjectListItem>
							</items>
						</List>
					</ScrollContainer>
				</VBox>
				<VBox class="utility-charts">
					<VBox class="card">
						<FlexBox
							class="card-header">
							<Text
								class="card-title"
								text="Penggunaan Air" />
							<HBox>
								<ComboBox
									id="ComboBoxTenant"
									width="132px"
									placeholder="Pilih Tenant"
									selectionChange="onChartTenantSelected"
									selectedKey="*"
									class="sapUiTinyMarginEnd sapMCbAutoFocus"
									items="">
									<core:Item
										key="*"
										text="Semua Tenant" />
									<core:Item
										key="Tenant A"
										text="Tenant A" />
									<core:Item
										key="Tenant B"
										text="Tenant B" />
									<core:Item
										key="Tenant C"
										text="Tenant C" />
									<core:Item
										key="Tenant D"
										text="Tenant D" />
									<core:Item
										key="Tenant E"
										text="Tenant E" />
									<core:Item
										key="Tenant F"
										text="Tenant F" />
								</ComboBox>
								<ComboBox
									id="ComboBoxMonth"
									width="120px"
									placeholder="Pilih bulan"
									selectionChange="onChartMonthSelected"
									selectedKey="*"
									class="sapUiTinyMarginEnd sapMCbAutoFocus"
									items="">
									<core:Item
										key="Januari"
										text="Januari" />
									<core:Item
										key="Februari"
										text="Februari" />
									<core:Item
										key="Maret"
										text="Maret" />
									<core:Item
										key="April"
										text="April" />
									<core:Item
										key="Mei"
										text="Mei" />
									<core:Item
										key="Juni"
										text="Juni" />
									<core:Item
										key="Juli"
										text="Juli" />
									<core:Item
										key="Agustus"
										text="Agustus" />
									<core:Item
										key="September"
										text="September" />
									<core:Item
										key="Oktober"
										text="Oktober" />
									<core:Item
										key="November"
										text="November" />
									<core:Item
										key="Desember"
										text="Desember" />
								</ComboBox>
							</HBox>
						</FlexBox>
						<VBox>
							<viz:VizFrame
								id="vizPenggunaanAir"
								height="220px"
								width="100%"
								vizType="column"
								busyIndicatorDelay="500"
								legendVisible="false">
								<viz:dataset>
									<viz.data:FlattenedDataset data="{penggunaanAir>/data}">
										<viz.data:dimensions>
											<viz.data:DimensionDefinition
												name="Category"
												value="{penggunaanAir>tenant}" />
										</viz.data:dimensions>
										<viz.data:measures>
											<viz.data:MeasureDefinition
												name="Value"
												value="{penggunaanAir>value}" />
										</viz.data:measures>
									</viz.data:FlattenedDataset>
								</viz:dataset>
								<viz:feeds>
									<viz.feeds:FeedItem
										id="valueAxisFeed"
										uid="valueAxis"
										type="Measure"
										values="Value" />
									<viz.feeds:FeedItem
										id="categoryAxisFeed"
										uid="categoryAxis"
										type="Dimension"
										values="Category" />
								</viz:feeds>
							</viz:VizFrame>
						</VBox>
					</VBox>
					<VBox class="card">
						<FlexBox
							class="card-header">
							<Text
								class="card-title"
								text="Penggunaan Listrik" />
							<HBox>
								<ComboBox
									id="ListrikTimestampFilter"
									width="120px"
									placeholder="Pilih bulan"
									selectionChange="onListrikChartTimestamp"
									selectedKey="6months"
									class="sapUiTinyMarginEnd sapMCbAutoFocus"
									items="">
									<core:Item
										key="6months"
										text="6 Months" />
									<core:Item
										key="1year"
										text="1 Year" />
									<core:Item
										key="*"
										text="Semua" />
								</ComboBox>
							</HBox>
						</FlexBox>
						<VBox height="100%">
							<viz:VizFrame
								id="vizPenggunaanListrik"
								height="220px"
								width="100%"
								vizType="line"
								busyIndicatorDelay="500"
								legendVisible="false">
								<viz:dataset>
									<viz.data:FlattenedDataset data="{penggunaanListrik>/data}">
										<viz.data:dimensions>
											<viz.data:DimensionDefinition
												name="Category"
												value="{penggunaanListrik>month}" />
										</viz.data:dimensions>
										<viz.data:measures>
											<viz.data:MeasureDefinition
												name="Value"
												value="{penggunaanListrik>value}" />
										</viz.data:measures>
									</viz.data:FlattenedDataset>
								</viz:dataset>
								<viz:feeds>
									<viz.feeds:FeedItem
										id="listrikValueAxisFeed"
										uid="valueAxis"
										type="Measure"
										values="Value" />
									<viz.feeds:FeedItem
										id="listrikCategoryAxisFeed"
										uid="categoryAxis"
										type="Dimension"
										values="Category" />
								</viz:feeds>
							</viz:VizFrame>
						</VBox>
					</VBox>
				</VBox>
			</HBox>
		</VBox>
	</Page>
</mvc:View>